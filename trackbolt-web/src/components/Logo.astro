---
/**
 * Marca Trackbolt: logotipo real del cliente (public/img/marca/logo.jpeg).
 */
interface Props {
  href?: string | null;
}
const { href = '/' } = Astro.props;
const Etiqueta = href ? 'a' : 'div';
---

<Etiqueta class="marca" {...(href ? { href, 'aria-label': 'Trackbolt — inicio' } : {})}>
  <img src="/img/marca/logo.jpeg" alt="Trackbolt" width="1600" height="533" />
</Etiqueta>
