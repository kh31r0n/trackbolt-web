---
/**
 * Franja fija que identifica la compilación como demostración.
 * Solo se monta cuando `ES_DEMO` es verdadero (ver src/data/demo.ts).
 */
import { demo } from '../data/demo';
---

<aside class="banner-demo" role="note" aria-label="Aviso de sitio de demostración">
  <span class="cinta" aria-hidden="true"></span>
  <p class="aviso">
    <strong>{demo.etiqueta}</strong>
    <span>{demo.mensaje}</span>
  </p>
  <span class="cinta" aria-hidden="true"></span>
</aside>

<span class="sello-demo" aria-hidden="true">{demo.sello}</span>

<style>
  .banner-demo {
    display: flex;
    align-items: stretch;
    background: var(--negro);
    color: var(--blanco);
    border-bottom: 2px solid var(--rojo);
  }

  /* Cintas de peligro a lado y lado del texto. */
  .cinta {
    flex: 0 0 clamp(1.5rem, 9vw, 7rem);
    background: repeating-linear-gradient(
      -45deg,
      var(--rojo) 0 9px,
      transparent 9px 18px
    );
    opacity: 0.85;
  }

  .aviso {
    flex: 1 1 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.15rem 0.65rem;
    padding: 0.55rem 1rem;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .aviso strong {
    font-family: var(--display);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--rojo-vivo);
  }

  .aviso span {
    color: var(--gris-claro);
  }

  /* Sello que acompaña el desplazamiento, para que el aviso no se pierda
     al bajar en las páginas largas del catálogo. */
  .sello-demo {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 90;
    padding: 0.32rem 0.62rem;
    border-radius: var(--radio);
    background: var(--rojo);
    color: var(--blanco);
    font-family: var(--display);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  @media (max-width: 560px) {
    .aviso {
      font-size: 0.74rem;
    }
  }

  @media print {
    .sello-demo {
      display: none;
    }
  }
</style>
