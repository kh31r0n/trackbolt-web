---
import Base from '../../layouts/Base.astro';
import Catalogo from '../../components/Catalogo.astro';
import IconoLinea from '../../components/IconoLinea.astro';
import lineas from '../../../data/generado/lineas.json';

export function getStaticPaths() {
  return (lineas as any[]).map((l) => ({ params: { linea: l.slug }, props: { linea: l } }));
}

const { linea } = Astro.props as { linea: any };
const otras = (lineas as any[]).filter((l) => l.slug !== linea.slug).slice(0, 5);
---

<Base
  titulo={linea.nombre}
  descripcion={`${linea.descripcion} ${linea.total} referencias con filtro por diámetro, largo, grado y acabado.`}
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://trackbolt.co/' },
      { '@type': 'ListItem', position: 2, name: 'Líneas de producto', item: 'https://trackbolt.co/lineas/' },
      { '@type': 'ListItem', position: 3, name: linea.nombre },
    ],
  }}
>
  <div class="contenedor">
    <nav class="miga" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/lineas/">Líneas</a>
      <span aria-hidden="true">/</span>
      <span>{linea.nombre}</span>
    </nav>

    <div style="display:flex;gap:1.25rem;align-items:flex-start;padding-bottom:1.5rem">
      <div style="flex-shrink:0;margin-top:0.35rem"><IconoLinea linea={linea.slug} tamano={52} /></div>
      <div style="max-width:64ch">
        <div class="regla"></div>
        <h1 style="font-size:clamp(1.7rem,3.6vw,2.4rem)">{linea.nombre}</h1>
        <p class="entradilla" style="margin-top:0.75rem">{linea.descripcion}</p>
        <p class="mono" style="margin-top:0.75rem;font-size:0.82rem;color:var(--rojo);font-weight:700">
          {linea.total.toLocaleString('es-CO')} referencias
        </p>
      </div>
    </div>

    {
      linea.grupos.length > 1 && (
        <div style="display:flex;flex-wrap:wrap;gap:0.4rem;padding-bottom:2rem">
          {linea.grupos.map((g: any) => (
            <a
              class="btn btn-linea btn-pequeno"
              href={`/lineas/${linea.slug}/?g=${encodeURIComponent(g.nombre)}`}
            >
              {g.nombre} <span class="mono" style="opacity:0.6">{g.total}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="contenedor" style="padding-bottom:3.5rem">
    <Catalogo lineaFija={linea.slug} />
  </div>

  <section class="seccion-compacta hueso">
    <div class="contenedor">
      <h2 style="font-size:1.1rem;margin-bottom:1.25rem">Otras líneas</h2>
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem">
        {
          otras.map((l) => (
            <a class="btn btn-linea btn-pequeno" href={`/lineas/${l.slug}/`}>
              {l.nombre}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
