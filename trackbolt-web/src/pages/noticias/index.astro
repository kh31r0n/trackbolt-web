---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { whatsapp } from '../../data/sitio';

const entradas = (await getCollection('noticias'))
  .filter((e) => !e.data.borrador)
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const fecha = (d: Date) =>
  d.toLocaleDateString('es-CO', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Base
  titulo="Noticias"
  descripcion="Novedades de producto, guías técnicas y avisos de Trackbolt: tornillería de alta resistencia para maquinaria pesada."
>
  <div class="contenedor">
    <nav class="miga" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <span>Noticias</span>
    </nav>
    <div style="max-width:60ch;padding-bottom:2.5rem">
      <div class="regla"></div>
      <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">Noticias</h1>
      <p class="entradilla" style="margin-top:0.75rem">
        Novedades de inventario, guías técnicas y avisos de operación.
      </p>
    </div>
  </div>

  <section class="seccion-compacta">
    <div class="contenedor">
      {
        entradas.length === 0 ? (
          <div class="vacio">
            <p style="font-weight:700;color:var(--tinta)">Todavía no hay publicaciones.</p>
            <p style="margin-top:0.5rem">
              La sección está lista: cada archivo <span class="mono">.md</span> en{' '}
              <span class="mono">src/content/noticias/</span> se publica automáticamente.
            </p>
          </div>
        ) : (
          <div class="rejilla rejilla-2">
            {entradas.map((e) => (
              <a class="tarjeta tarjeta-linea" href={`/noticias/${e.id}/`}>
                <p class="etiqueta">{fecha(e.data.fecha)}</p>
                <h2 style="font-size:1.2rem">{e.data.titulo}</h2>
                <p style="font-size:0.9rem;color:var(--gris)">{e.data.resumen}</p>
                <span class="conteo">Leer →</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="franja">
    <div class="contenedor">
      <div>
        <h2>Novedades por WhatsApp</h2>
        <p>Te avisamos cuando llegan referencias nuevas de rodaje o cambia una lista de precios.</p>
      </div>
      <a
        class="btn btn-linea"
        href={whatsapp('Hola Trackbolt, quiero recibir avisos de novedades e inventario.')}
        target="_blank"
        rel="noopener">Quiero recibir avisos</a
      >
    </div>
  </section>
</Base>
